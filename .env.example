# ============================================================================
# QAAGA AGENT — Production Environment Configuration (.env.example)
# ============================================================================

# 1. OpenAI Server-Side Integration (Read strictly from process.env; NEVER expose to client/browser)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Optional: Secondary Server-Side Provider (Only used when explicitly selected)
GEMINI_API_KEY=""

# 2. Cloud SQL (PostgreSQL) Runtime Connection Pool Variables (Object Method)
# Provided automatically in Cloud Run / AI Studio Cloud SQL environment.
SQL_HOST="/cloudsql/project:region:instance"
SQL_DB_NAME="postgres"
SQL_USER="app_user"
SQL_PASSWORD=""

# 3. Cloud SQL Admin Credentials (Used strictly by Drizzle Kit migrations)
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD=""

# 4. Authentication & Administrator Bootstrap
AUTH_JWT_SECRET="replace-with-64-byte-cryptographic-random-secret"
ADMIN_BOOTSTRAP_EMAIL="rafsankhan.tv@gmail.com"

# 5. Application Public Origin
APP_URL="http://localhost:3000"
