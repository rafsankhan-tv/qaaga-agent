# Non-secret Bun package installer flags for Cloud Run / gVisor cold-boot reliability.
# Prevents 240+ concurrent IPv6/IPv4 SYN bursts from stalling `bun install` on cold start.
# Never store API keys or secrets in this file — use AI Studio Settings > Secrets.
BUN_CONFIG_MAX_HTTP_REQUESTS=6
BUN_FEATURE_FLAG_DISABLE_IPV6=1
